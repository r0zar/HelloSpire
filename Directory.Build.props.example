<Project>
    <PropertyGroup>
        <!-- Copy this file to Directory.Build.props and edit the paths for your machine.
             Directory.Build.props is gitignored because these paths are machine-specific. -->

        <!-- MegaDot / Godot 4.5.1 mono executable, used for export-pack when publishing.
             MegaDot's current version is 4.5.1, and the game will NOT load your .pck if the
             Godot version used to export it is newer. Stock Godot 4.5.1 .NET works too. -->
        <GodotPath>C:/Users/YOU/Tools/Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>

        <!-- Other platforms:
             /usr/lib/megadot/MegaDot_v4.5.1-stable_mono_linux.x86_64
             /Users/user/Applications/Megadot.app/Contents/MacOS/Godot -->

        <!-- If Slay the Spire 2 is not found automatically, uncomment and set it manually -->
        <!-- <Sts2Path>C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path> -->
    </PropertyGroup>
</Project>
